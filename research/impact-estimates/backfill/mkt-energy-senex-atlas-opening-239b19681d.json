{
  "schema_version": 1,
  "title": "Senex 60 PJ expansion cash-flow sensitivity",
  "description": "Conditional annual cash-flow sensitivity from Senex sales volume, unit margin, operating cost and POSCO International share.",
  "as_of": "2024-11-25",
  "confidence": "low",
  "notice": "Public production target plus assumptions; price, cost, contract and ramp timing are not disclosed and this is not a company forecast.",
  "formula_display": "sales_pj × margin_aud_gj × ownership_share − opex_aud_m",
  "variables": [
    {
      "id": "sales_pj",
      "label": "Annual sales volume",
      "unit": "PJ",
      "min": 10,
      "max": 60,
      "step": 5,
      "default": 36,
      "kind": "derived",
      "basis": "Senex 60 PJ target with staged ramp-up assumption.",
      "source_ids": []
    },
    {
      "id": "margin_aud_gj",
      "label": "Unit margin",
      "unit": "AUD/GJ",
      "min": 0.5,
      "max": 4,
      "step": 0.5,
      "default": 2,
      "kind": "assumption",
      "basis": "Contract price and operating cost are not public.",
      "source_ids": []
    },
    {
      "id": "ownership_share",
      "label": "POSCO International ownership share",
      "unit": "share",
      "min": 0.45,
      "max": 0.55,
      "step": 0.01,
      "default": 0.5,
      "kind": "assumption",
      "basis": "Ownership is held as an assumption until source registration.",
      "source_ids": []
    },
    {
      "id": "opex_aud_m",
      "label": "Annual operating and response cost",
      "unit": "AUD million",
      "min": 10,
      "max": 150,
      "step": 10,
      "default": 60,
      "kind": "assumption",
      "basis": "Company operating cost is not public.",
      "source_ids": []
    }
  ],
  "outputs": [
    {
      "id": "cashflow",
      "label": "Indicative annual cash flow",
      "unit": "AUD million",
      "decimals": 1,
      "primary": true,
      "expression": {
        "op": "subtract",
        "args": [
          {
            "op": "multiply",
            "args": [
              {
                "op": "multiply",
                "args": [
                  {
                    "var": "sales_pj"
                  },
                  {
                    "var": "margin_aud_gj"
                  }
                ]
              },
              {
                "var": "ownership_share"
              }
            ]
          },
          {
            "var": "opex_aud_m"
          }
        ]
      }
    }
  ],
  "presets": [
    {
      "id": "defensive",
      "label": "Defensive",
      "values": {
        "sales_pj": 45,
        "margin_aud_gj": 2.5,
        "ownership_share": 0.5,
        "opex_aud_m": 45
      }
    },
    {
      "id": "base",
      "label": "Base",
      "values": {
        "sales_pj": 36,
        "margin_aud_gj": 2,
        "ownership_share": 0.5,
        "opex_aud_m": 60
      }
    },
    {
      "id": "pressure",
      "label": "Pressure",
      "values": {
        "sales_pj": 20,
        "margin_aud_gj": 1,
        "ownership_share": 0.5,
        "opex_aud_m": 100
      }
    }
  ]
}
