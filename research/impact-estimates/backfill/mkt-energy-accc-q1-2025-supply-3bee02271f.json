{
  "schema_version": 1,
  "title": "2025 Q1 east coast gas supply premium sensitivity",
  "description": "Senex southern-delivery volume and supply premium sensitivity for POSCO International share EBITDA.",
  "as_of": "2024-09-27",
  "confidence": "low",
  "notice": "Preliminary public-information model; contract volume, transport cost and company margin are not disclosed and this is not a company forecast.",
  "formula_display": "sales_pj × spread_aud_gj × ownership_share",
  "variables": [
    {
      "id": "sales_pj",
      "label": "Affected sales volume",
      "unit": "PJ",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 5,
      "kind": "assumption",
      "basis": "Senex contract and delivered volume are not public.",
      "source_ids": []
    },
    {
      "id": "spread_aud_gj",
      "label": "Price and transport spread",
      "unit": "AUD/GJ",
      "min": 0.5,
      "max": 5,
      "step": 0.5,
      "default": 2,
      "kind": "assumption",
      "basis": "ACCC supply-risk range used as a sensitivity assumption.",
      "source_ids": []
    },
    {
      "id": "ownership_share",
      "label": "POSCO International ownership share",
      "unit": "share",
      "min": 0.45,
      "max": 0.55,
      "step": 0.01,
      "default": 0.5,
      "kind": "assumption",
      "basis": "Ownership is held as an assumption until the source is registered.",
      "source_ids": []
    }
  ],
  "outputs": [
    {
      "id": "ebitda_swing",
      "label": "Indicative EBITDA sensitivity",
      "unit": "AUD million",
      "decimals": 1,
      "primary": true,
      "expression": {
        "op": "multiply",
        "args": [
          {
            "op": "multiply",
            "args": [
              {
                "var": "sales_pj"
              },
              {
                "var": "spread_aud_gj"
              }
            ]
          },
          {
            "var": "ownership_share"
          }
        ]
      }
    }
  ],
  "presets": [
    {
      "id": "defensive",
      "label": "Defensive",
      "values": {
        "sales_pj": 3,
        "spread_aud_gj": 1,
        "ownership_share": 0.5
      }
    },
    {
      "id": "base",
      "label": "Base",
      "values": {
        "sales_pj": 5,
        "spread_aud_gj": 2,
        "ownership_share": 0.5
      }
    },
    {
      "id": "pressure",
      "label": "Pressure",
      "values": {
        "sales_pj": 8,
        "spread_aud_gj": 4,
        "ownership_share": 0.5
      }
    }
  ]
}
