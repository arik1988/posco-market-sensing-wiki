{
  "schema_version": 1,
  "title": "인도 평강 세이프가드의 POSCO 매출 예비 영향",
  "description": "DGTR 권고율이 POSCO 인도향 물량에 적용된다는 가정의 모델입니다.",
  "as_of": "2026-08-19",
  "confidence": "low",
  "notice": "권고와 최종 부과, 품목별 적용·전가율은 미확인입니다.",
  "formula_display": "순영향 = 인도 물량 × (가격전가액 - 관세 회사부담액)",
  "variables": [
    {
      "id": "india_tonnes",
      "label": "인도 대상 물량",
      "unit": "t/year",
      "min": 0,
      "max": 1000000,
      "step": 25000,
      "default": 300000,
      "kind": "assumption",
      "basis": "내부 인도 판매자료 필요",
      "source_ids": []
    },
    {
      "id": "pass_through",
      "label": "가격전가액",
      "unit": "USD/t",
      "min": 0,
      "max": 200,
      "step": 10,
      "default": 60,
      "kind": "assumption",
      "basis": "고객계약 가정",
      "source_ids": []
    },
    {
      "id": "duty_burden",
      "label": "회사 부담 관세",
      "unit": "USD/t",
      "min": 0,
      "max": 300,
      "step": 10,
      "default": 120,
      "kind": "assumption",
      "basis": "12% 권고의 단순 대용",
      "source_ids": []
    }
  ],
  "outputs": [
    {
      "id": "revenue_impact",
      "label": "연간 순매출 영향",
      "unit": "USD",
      "decimals": 0,
      "primary": true,
      "expression": {
        "op": "multiply",
        "args": [
          {
            "var": "india_tonnes"
          },
          {
            "op": "subtract",
            "args": [
              {
                "var": "pass_through"
              },
              {
                "var": "duty_burden"
              }
            ]
          }
        ]
      }
    }
  ],
  "presets": [
    {
      "id": "defense",
      "label": "방어 시나리오",
      "values": {
        "india_tonnes": 300000,
        "pass_through": 120,
        "duty_burden": 0
      }
    },
    {
      "id": "base",
      "label": "기준 시나리오",
      "values": {
        "india_tonnes": 300000,
        "pass_through": 60,
        "duty_burden": 120
      }
    },
    {
      "id": "pressure",
      "label": "압박 시나리오",
      "values": {
        "india_tonnes": 200000,
        "pass_through": 0,
        "duty_burden": 180
      }
    }
  ]
}
