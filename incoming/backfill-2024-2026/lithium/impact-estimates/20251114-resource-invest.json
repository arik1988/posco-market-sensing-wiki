{
  "schema_version": 1,
  "title": "글로벌 리튬 자원 매출 잠재력",
  "description": "확보 자원의 가동률과 가격을 적용한 연간 매출 잠재력.",
  "as_of": "2026-08-19",
  "confidence": "medium",
  "notice": "공개자료 기반 민감도 초안이며 POSCO 실제 원가·계약·물량이 아닙니다.",
  "variables": [
    {
      "id": "equiv",
      "label": "LiOH 환산능력",
      "unit": "kt/년",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 37,
      "kind": "verified",
      "basis": "POSCO 발표 37kt/년",
      "source_ids": [
        "$SOURCE_ID"
      ]
    },
    {
      "id": "utilization",
      "label": "가동률",
      "unit": "fraction",
      "min": 0.1,
      "max": 1,
      "step": 0.05,
      "default": 0.5,
      "kind": "assumption",
      "basis": "상업화 가동률",
      "source_ids": []
    },
    {
      "id": "price",
      "label": "수산화리튬 가격",
      "unit": "USD/t",
      "min": 3000,
      "max": 30000,
      "step": 500,
      "default": 12000,
      "kind": "assumption",
      "basis": "시장 가격 시나리오",
      "source_ids": []
    }
  ],
  "outputs": [
    {
      "id": "annual_resource_revenue",
      "label": "연간 자원 매출 잠재력",
      "unit": "USD m/년",
      "decimals": 1,
      "primary": true,
      "expression": {
        "op": "divide",
        "args": [
          {
            "op": "multiply",
            "args": [
              {
                "op": "multiply",
                "args": [
                  {
                    "var": "equiv"
                  },
                  {
                    "var": "utilization"
                  }
                ]
              },
              {
                "var": "price"
              }
            ]
          },
          1000
        ]
      }
    }
  ],
  "presets": [
    {
      "id": "downside",
      "label": "하방",
      "values": {
        "equiv": 25,
        "utilization": 0.3,
        "price": 8000
      }
    },
    {
      "id": "base",
      "label": "기준",
      "values": {
        "equiv": 37,
        "utilization": 0.5,
        "price": 12000
      }
    },
    {
      "id": "upside",
      "label": "상방",
      "values": {
        "equiv": 37,
        "utilization": 0.8,
        "price": 18000
      }
    }
  ]
}
