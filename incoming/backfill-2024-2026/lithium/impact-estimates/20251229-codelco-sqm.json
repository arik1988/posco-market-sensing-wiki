{
  "schema_version": 1,
  "title": "칠레 공급·가격 스프레드 민감도",
  "description": "NovaAndino 공급량에 가격과 비용의 차이를 적용한 연간 스프레드 민감도.",
  "as_of": "2026-08-19",
  "confidence": "low",
  "notice": "공개자료 기반 민감도 초안이며 POSCO 실제 원가·계약·물량이 아닙니다.",
  "variables": [
    {
      "id": "volume",
      "label": "공급량",
      "unit": "kt",
      "min": 1,
      "max": 100,
      "step": 1,
      "default": 50,
      "kind": "verified",
      "basis": "NovaAndino 공급 전망 대용값",
      "source_ids": [
        "$SOURCE_ID"
      ]
    },
    {
      "id": "price",
      "label": "가격",
      "unit": "USD/t",
      "min": 3000,
      "max": 30000,
      "step": 500,
      "default": 12000,
      "kind": "assumption",
      "basis": "시장 가격 시나리오",
      "source_ids": []
    },
    {
      "id": "cost",
      "label": "비용",
      "unit": "USD/t",
      "min": 100,
      "max": 30000,
      "step": 100,
      "default": 500,
      "kind": "assumption",
      "basis": "염수·정책 비용 대용값",
      "source_ids": []
    }
  ],
  "outputs": [
    {
      "id": "supply_spread",
      "label": "공급 스프레드",
      "unit": "USD m",
      "decimals": 1,
      "primary": true,
      "expression": {
        "op": "divide",
        "args": [
          {
            "op": "multiply",
            "args": [
              {
                "var": "volume"
              },
              {
                "op": "subtract",
                "args": [
                  {
                    "var": "price"
                  },
                  {
                    "var": "cost"
                  }
                ]
              }
            ]
          },
          1000
        ]
      }
    }
  ],
  "presets": [
    {
      "id": "downside",
      "label": "하방",
      "values": {
        "volume": 40,
        "price": 8000,
        "cost": 1000
      }
    },
    {
      "id": "base",
      "label": "기준",
      "values": {
        "volume": 50,
        "price": 12000,
        "cost": 500
      }
    },
    {
      "id": "upside",
      "label": "상방",
      "values": {
        "volume": 60,
        "price": 18000,
        "cost": 500
      }
    }
  ]
}
